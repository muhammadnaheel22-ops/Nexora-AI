    "seed": "node src/scripts/seed.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parse": "^5.6.0",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.9.1",
    "mathjs": "^14.6.0",
    "multer": "^2.0.2",
    "mysql2": "^3.23.2",
    "pdf-parse": "^1.1.1",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "eslint": "^9.32.0",
    "supertest": "^7.1.4",
    "vitest": "^3.2.4"
