# =========================================================
# NEXORA AI - ENVIRONMENT CONFIGURATION
# =========================================================

# ---------------------------------------------------------
# Application
# ---------------------------------------------------------

NODE_ENV=development
PORT=4000


# ---------------------------------------------------------
# Database
# Local development example only.
# NEVER put your real TiDB username/password in this file.
# Production DATABASE_URL must be configured in Render.
# ---------------------------------------------------------

DATABASE_URL=mysql://username:password@127.0.0.1:3306/nexora_ai
MYSQL_POOL_LIMIT=10


# ---------------------------------------------------------
# Authentication
# Generate a real secure value for Render.
# Never commit the real JWT secret to GitHub.
# ---------------------------------------------------------

JWT_SECRET=change-this-to-a-random-string-at-least-32-characters-long


# ---------------------------------------------------------
# AI - Groq
# Groq provides an OpenAI-compatible API.
# The real API key must be configured in Render.
# ---------------------------------------------------------

AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1

AI_MODEL=llama-3.3-70b-versatile

AI_JSON_MODE=true


# ---------------------------------------------------------
# Embeddings / RAG
#
# IMPORTANT:
# Groq chat configuration and embedding configuration should
# not be assumed to use the same provider.
#
# Leave the embedding model empty until the embedding service
# is configured for a supported embedding provider.
# ---------------------------------------------------------

AI_EMBEDDING_MODEL=


# ---------------------------------------------------------
# CORS
#
# Local development:
# http://localhost:5173
#
# On Render replace CORS_ORIGIN with the real Vercel frontend
# URL after the frontend has been deployed.
# ---------------------------------------------------------

CORS_ORIGIN=http://localhost:5173


# ---------------------------------------------------------
# File Uploads
# ---------------------------------------------------------

FILE_STORAGE_DIR=uploads
MAX_UPLOAD_MB=15


# ---------------------------------------------------------
# Multi-Agent Configuration
# ---------------------------------------------------------

MAX_AGENT_RETRIES=1
MAX_REVIEW_RETRIES=1
AGENT_TIMEOUT_MS=60000


# ---------------------------------------------------------
# Rate Limiting
# ---------------------------------------------------------

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120


# ---------------------------------------------------------
# RAG Configuration
# ---------------------------------------------------------

RAG_TOP_K=6
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=180


# ---------------------------------------------------------
# Optional Search
# ---------------------------------------------------------

SEARCH_API_KEY=


# ---------------------------------------------------------
# Optional Vector Database
# ---------------------------------------------------------

VECTOR_DATABASE_URL=
VECTOR_DATABASE_API_KEY=
VECTOR_COLLECTION=nexora_documents


# ---------------------------------------------------------
# Optional Seed Admin
# Never put a real password in .env.example
# ---------------------------------------------------------

ADMIN_NAME=Nexora Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
