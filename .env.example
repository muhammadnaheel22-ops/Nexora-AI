NODE_ENV=development
PORT=4000
DATABASE_URL=mysql://nexora:nexora_dev_password@127.0.0.1:3306/nexora_ai
MYSQL_POOL_LIMIT=10
JWT_SECRET=change-this-to-a-random-string-at-least-32-characters-long

# OpenAI-compatible API. Leave AI_API_KEY empty if you only want to test the UI/database.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-5-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_JSON_MODE=true

CORS_ORIGIN=http://localhost:5173
FILE_STORAGE_DIR=uploads
MAX_UPLOAD_MB=15
MAX_AGENT_RETRIES=1
MAX_REVIEW_RETRIES=1
AGENT_TIMEOUT_MS=60000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
RAG_TOP_K=6
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=180

# Optional features
SEARCH_API_KEY=
VECTOR_DATABASE_URL=
VECTOR_DATABASE_API_KEY=
VECTOR_COLLECTION=nexora_documents

# Optional seed admin
ADMIN_NAME=Nexora Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
